echo "Waiting for pipeline completion..."
MAX_WAIT=2700
ELAPSED=0
SLEEP_INTERVAL=30

while true; do
  STATUS=$(aws sagemaker describe-pipeline-execution \
    --pipeline-execution-arn $EXECUTION_ARN \
    --query "PipelineExecutionStatus" \
    --output text)

  echo "  [${ELAPSED}s] Pipeline status: $STATUS"

  if [ "$STATUS" = "Succeeded" ]; then
    echo "Pipeline succeeded"
    # Record the package this run registered. post_build rejects it
    # if anything after this point fails the build (see post_build).
    aws sagemaker list-pipeline-execution-steps \
      --pipeline-execution-arn $EXECUTION_ARN \
      --query "PipelineExecutionSteps[?starts_with(StepName,'RegisterChurnModel')].Metadata.RegisterModel.Arn" \
      --output text > /tmp/model_package_arn.txt
    echo "Registered: $(cat /tmp/model_package_arn.txt)"
    break
  elif [ "$STATUS" = "Failed" ] || [ "$STATUS" = "Stopped" ]; then
    echo "Pipeline $STATUS - check SageMaker Studio for details"
    aws sagemaker list-pipeline-execution-steps \
      --pipeline-execution-arn $EXECUTION_ARN \
      --query "PipelineExecutionSteps[].{Step:StepName,Status:StepStatus,Reason:FailureReason}" \
      --output table || true
    exit 1
  fi

  ELAPSED=$((ELAPSED + SLEEP_INTERVAL))
  if [ $ELAPSED -ge $MAX_WAIT ]; then
    echo "Pipeline timed out after ${MAX_WAIT}s"
    exit 1
  fi

  sleep $SLEEP_INTERVAL
done

